# ---------------------------------------------------------------------------
# jobfather-crawler environment template.  Copy to `.env` and fill in.
# `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- OpenAI (ingestion embeddings) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres (existing local PG16 cluster: %LOCALAPPDATA%\pgsql16) ---
# App role + database are created once by scripts/pg_setup.ps1
DATABASE_URL=postgresql+psycopg://jobfather:the-great-job-father@127.0.0.1:5432/jobfather
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jobfather
POSTGRES_USER=jobfather
POSTGRES_PASSWORD=the-great-job-father
POSTGRES_SUPERUSER=postgres

# --- Browser / Crawl4AI ---
# Chrome started with:  chrome.exe --remote-debugging-port=9222 --user-data-dir=...
CRAWLER_CDP_URL=http://localhost:9222
CRAWLER_CHROME_USER_DATA_DIR=.profiles/jobfather
CRAWLER_MAX_CONCURRENCY=8
CRAWLER_PAGE_TIMEOUT_MS=45000
CRAWLER_HEADLESS=false

# --- Runner ---
STAGING_DIR=data
LOG_LEVEL=INFO
